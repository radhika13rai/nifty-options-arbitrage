# ==============================================================================
# NIFTY OPTIONS ARBITRAGE SYSTEM — ENVIRONMENT TEMPLATE
# CRITICAL: NEVER COMMIT REAL SECRETS, TOKENS, OR CREDENTIALS
# ==============================================================================

# SYSTEM RUNTIME MODE
# ABSOLUTE SAFETY: MUST BE 'PAPER_TRADING' IN V1
EXECUTION_MODE=PAPER_TRADING

# LIVE TRADING SAFETY GATE (DO NOT SET TO TRUE IN V1)
LIVE_TRADING_ENABLED=false
HUMAN_APPROVAL_TOKEN=
COMPLIANCE_GATE_PASSED=false
RISK_GATE_PASSED=false

# STARTING VIRTUAL PAPER CAPITAL (INR)
STARTING_PAPER_CAPITAL=3000.00

# BROKER INTEGRATION (DHAN) — FOR MARKET DATA STREAMING
DHAN_CLIENT_ID=mock_client_id
DHAN_ACCESS_TOKEN=mock_access_token
DHAN_STATIC_IP=127.0.0.1

# DATABASE & CACHE
DATABASE_URL=sqlite+aiosqlite:///./trading_audit.db
REDIS_URL=redis://localhost:6379/0
USE_REDIS=false

# RISK ENGINE LIMITS
MAX_CAPITAL_EXPOSURE=3000.00
MAX_POSITION_SIZE=1
MAX_LOSS_PER_TRADE=150.00
MAX_DAILY_LOSS=300.00
MAX_OPEN_POSITIONS=1
MAX_ORDERS_PER_SECOND=2
MAX_ORDERS_PER_MINUTE=20
STALE_DATA_THRESHOLD_MS=1500
MAX_SPREAD_THRESHOLD=10.00
MIN_LIQUIDITY_BID_ASK_DEPTH=50

# SERVER CONFIGURATION
HOST=0.0.0.0
PORT=8000
DASHBOARD_PORT=3000
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
