import asyncio
from simulation.soak_runner import soak_runner

raw_seed = '$SEED_ARG'.strip()
if raw_seed.lower() in ('', 'none', 'random'):
    chosen_seed = None
    seed_desc = 'Random Stochastic (Non-Deterministic)'
else:
    try:
        chosen_seed = int(raw_seed)
        seed_desc = f'Fixed Seed {chosen_seed} (Deterministic)'
    except ValueError:
        chosen_seed = None
        seed_desc = f'Random Stochastic (Fallback from invalid seed: {raw_seed})'

async def run():
    print(f'\033[1m  AUTOMATED CONTINUOUS PAPER SOAK RUNNER (PAPER V2)\033[0m')
    print(f'  Target: \033[38;5;51m$DAYS trading days\033[0m | Speed: \033[38;5;51m$INTERVAL s/day\033[0m | Capital: \033[38;5;48m₹3,000\033[0m')
