    print(f'    Kill Switch:      {ks_badge}')
except Exception as e:
    print('    Telemetry parsing error:', e)
"
    else
        echo -e "  Process:   ${C_RED}${C_BOLD}OFFLINE${C_RESET}"
        echo -e "  Port $PORT:   ${C_GRAY}Free${C_RESET}"
        echo ""
        echo -e "${C_GRAY}To start the server, run: ${C_BOLD}./serq start${C_RESET}"
    fi
}

