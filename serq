        icon = '✓' if res.net_pnl >= 0 else '✗'
        color = '\033[38;5;48m' if res.net_pnl >= 0 else '\033[38;5;203m'
        print(f'  Day {met.days_completed:02d}/{met.target_days:02d} | {color}{icon}\033[0m {res.date_str} [{res.regime[:10]:10s}] PnL: {color}₹{res.net_pnl:+7.2f}\033[0m | Cash: ₹{res.ending_cash:.2f} | WR: {met.win_rate_pct:4.1f}%')

    soak_runner.register_callback(on_day)
    metrics = await soak_runner.run(max_days=$DAYS, interval_sec=$INTERVAL, seed=chosen_seed)
